{
  "name": "emotional-memory",
  "version": "0.1.0",
  "description": "情感状态与记忆检索：把带时间戳的情绪注解算成可用的状态，把上千条经历组织成能翻的树。零依赖。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./tree": "./src/tree.mjs",
    "./aliases": "./src/aliases.mjs"
  },
  "scripts": {
    "demo": "node examples/demo.mjs",
    "test": "node test/test.mjs && node test/tree.test.mjs && node test/perf.test.mjs",
    "test:affect": "node test/test.mjs",
    "test:memory": "node test/tree.test.mjs",
    "test:perf": "node test/perf.test.mjs",
    "check:readme": "node test/readme-check.mjs"
  },
  "keywords": [
    "affect",
    "emotion",
    "emotion-model",
    "state-machine",
    "memory",
    "retrieval",
    "semantic-search",
    "clustering",
    "hierarchical-index",
    "persona",
    "llm",
    "ai-companion",
    "russell-circumplex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaxlll/emotional-memory.git"
  },
  "homepage": "https://github.com/reaxlll/emotional-memory#readme",
  "bugs": {
    "url": "https://github.com/reaxlll/emotional-memory/issues"
  }
}
